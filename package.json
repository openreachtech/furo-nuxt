{
  "name": "@openreachtech/furo-nuxt",
  "version": "1.10.0",
  "description": "furo for Nuxt",
  "main": "index.js",
  "files": [
    "lib/",
    "types/"
  ],
  "scripts": {
    "build": "nuxt build",
    "dev": "npm run cache; nuxt dev",
    "generate": "nuxt generate",
    "start": "nuxt start",
    "cache": "node -e \"require('fs').rm('./node_modules/.cache', { recursive: true, force: true }, err => { if (err) console.error(err); console.log('Cache cleared'); })\"",
    "l": "npm run lint",
    "lint": "eslint .",
    "test": "export NODE_OPTIONS=\"$NODE_OPTIONS --experimental-vm-modules\"; jest --maxWorkers=5"
  },
  "type": "module",
  "keywords": [
    "furo",
    "nuxt"
  ],
  "author": "Open Reach Tech Inc.",
  "license": "Apache-2.0",
  "dependencies": {
    "@openreachtech/furo": "^1.11.0",
    "core-js": "^3.50.0",
    "nuxt": "^3.21.11",
    "vue": "^3.4.38"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/eslint-parser": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@openreachtech/eslint-config": "^3.0.2",
    "@openreachtech/jest-constructor-spy": "^1.1.2",
    "@openreachtech/jest-deep-containing": "^1.0.2",
    "@types/jest": "^29.5.14",
    "@vue/test-utils": "^2.4.11",
    "@vue/vue3-jest": "^29.2.6",
    "babel-jest": "^29.7.0",
    "eslint": "^9.39.5",
    "eslint-plugin-eslint-comments": "^3.2.0",
    "eslint-plugin-vue": "^9.33.0",
    "globals": "^15.15.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "whatwg-fetch": "^3.6.20"
  }
}
